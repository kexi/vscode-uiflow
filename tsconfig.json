{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ES2022",
		"lib": ["ES2022"],
		"sourceMap": true,
		"rootDirs": ["src"],
		"outDir": "./out",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"moduleResolution": "node"
	},
	"exclude": ["node_modules", ".vscode-test", "out", "dist"]
}
